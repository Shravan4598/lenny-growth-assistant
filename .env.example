# ==========================================
# Application
# ==========================================

APP_NAME=The Lenny Growth Assistant
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1


# ==========================================
# Database
# ==========================================

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/lenny_growth


# ==========================================
# LLM Provider
# ==========================================

LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=180


# ==========================================
# Ollama
# ==========================================

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b


# ==========================================
# Cloud Provider
# ==========================================

CLOUD_PROVIDER=
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=


# ==========================================
# Frontend / CORS
# ==========================================

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8501"]


# ==========================================
# Knowledge Base
# ==========================================

LENNY_REPOSITORY_PATH=data/external/lennys-newsletterpodcastdata
LENNY_CONTENT_TYPES=["podcasts","newsletters"]


# ==========================================
# Retrieval
# ==========================================

RETRIEVAL_INDEX_PATH=data/index/lenny.faiss
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.40
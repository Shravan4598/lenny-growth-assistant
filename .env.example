# ==========================================
# Application
# ==========================================

APP_NAME=The Lenny Growth Assistant
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1


# ==========================================
# Database
# ==========================================

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth


# ==========================================
# LLM Provider
# ==========================================

LLM_PROVIDER=ollama


# ==========================================
# Ollama
# ==========================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b


# ==========================================
# Cloud Provider
# ==========================================

CLOUD_PROVIDER=
CLOUD_MODEL=

# Example:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ==========================================
# Frontend / CORS
# ==========================================

CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]